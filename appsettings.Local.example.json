{
  "_comentario": [
    "Plantilla de configuracion local NO SENSIBLE. Copiala a appsettings.Local.json.",
    "Los secretos (cadena de conexion, Jwt:Secret, Smtp:Password, *:ClientSecret)",
    "NO van aqui: van en `dotnet user-secrets`. Ver la seccion 'Rotar credenciales'",
    "del README."
  ],
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "TrackerMultimedia",
    "Audience": "TrackerMultimedia",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Smtp": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Enabled": false
  },
  "OAuth": {
    "Google": {
      "Enabled": false,
      "RedirectUri": "http://localhost:5218/api/auth/google/callback"
    },
    "GitHub": {
      "Enabled": false,
      "RedirectUri": "http://localhost:5218/api/auth/github/callback"
    }
  },
  "AllowedHosts": "*"
}
