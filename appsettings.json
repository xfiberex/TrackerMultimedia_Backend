{
  "_comentario": [
    "Configuración base, versionada y SIN SECRETOS. La carga ASP.NET Core antes que",
    "ninguna otra fuente, así que aquí solo van valores por defecto que puedan verse",
    "en un repositorio público.",
    "",
    "Se sobrescribe, en este orden: appsettings.Local.json (solo en Development),",
    "dotnet user-secrets y variables de entorno.",
    "",
    "Los dos valores que NO están aquí y sin los cuales el backend se niega a",
    "arrancar son ConnectionStrings:DefaultConnection y Jwt:Secret. Van en",
    "user-secrets; el README explica cómo."
  ],

  "ConnectionStrings": {},

  "Database": {
    "ApplyMigrationsOnStartup": false
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },

  "Cleanup": {
    "Enabled": true,
    "IntervalHours": 6,
    "RefreshTokenRetentionDays": 7,
    "OAuthStateRetentionDays": 1
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },

  "Jwt": {
    "Issuer": "TrackerMultimedia",
    "Audience": "TrackerMultimedia",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },

  "Smtp": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Enabled": false
  },

  "OAuth": {
    "Google": {
      "Enabled": false,
      "RedirectUri": "http://localhost:5218/api/auth/google/callback"
    },
    "GitHub": {
      "Enabled": false,
      "RedirectUri": "http://localhost:5218/api/auth/github/callback"
    }
  },

  "AllowedHosts": "*"
}
