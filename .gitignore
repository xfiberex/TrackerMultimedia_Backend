# ── Configuración con secretos ───────────────────────────────────────────────
# Nunca versionar archivos que puedan contener credenciales.
# Los secretos de desarrollo van en `dotnet user-secrets` (ver README.md).
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json

# ── Claves y certificados ─────────────────────────────────────────────────────
*.pfx
*.pem
*.key
*.p12
*.cer

# ── Build ─────────────────────────────────────────────────────────────────────
bin/
obj/

# Salidas de `dotnet publish` que se dejaron caer dentro del repositorio.
# Son 68 MB de DLL reconstruibles: nunca deben volver a versionarse.
artifacts/

# Caché de Visual Studio. Incluye DocumentLayout.json, que guarda rutas
# absolutas de la máquina donde se abrió la solución.
.vs/

# ── Testing local / reports ───────────────────────────────────────────────────
# Los tests se versionan como código fuente; sus resultados y coberturas, no.
TestResults/
coverage/
coverage-*/
*.trx
*.coverage
*.coveragexml
*.opencover.xml
*.testresults

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
.DS_Store
Thumbs.db